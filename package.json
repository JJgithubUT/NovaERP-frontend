{
  "name": "nova-erp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build:sw",
    "build:app": "ng build",
    "build:sw": "node scripts/build-sw.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/check-cwd-casing.mjs",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.sw.json",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\"",
    "preview": "npm run build && npx http-server dist/nova-erp/browser -p 4300 -c-1"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/angular-query-experimental": "^5.101.2",
    "big.js": "^7.0.1",
    "dexie": "^4.4.4",
    "postcss": "^8.5.19",
    "qrcode": "^1.5.4",
    "repomix": "^1.16.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.2",
    "tslib": "^2.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@tanstack/query-devtools": "^5.101.2",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
