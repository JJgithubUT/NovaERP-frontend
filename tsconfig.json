/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    /*
     * Obliga a comprobar antes de indexar un array o un Record. En este
     * proyecto no es teoría: `results[0]` de una página vacía es `undefined`, y
     * sin esto TypeScript juraría que es un Producto.
     */
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@app/*": ["./src/app/*"],
      "@env/*": ["./src/environments/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "typeCheckHostBindings": true
  },
  "files": [],
  /*
   * Las referencias existen para que el editor sepa qué proyecto gobierna cada
   * archivo. No corras `tsc -b` sobre ellas: ninguno define `outDir`, así que
   * la build emitiría los `.js` al lado de los fuentes. Para validar los tres
   * proyectos usa `npm run typecheck`, que invoca cada uno con `--noEmit`.
   */
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.sw.json"
    }
  ]
}
